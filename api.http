@baseUrl = http://localhost:4000
@email = candidate2@example.com
@password = secure-password

### Register a candidate (201)
# @name register
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{
  "name": "Example Candidate",
  "email": "{{email}}",
  "password": "{{password}}"
}

### Sign in (200)
# Run this after registration. It refreshes the captured variables.
# @name signIn
POST {{baseUrl}}/api/auth/sign-in
Content-Type: application/json

{
  "email": "{{email}}",
  "password": "{{password}}"
}

###
# Captured variables from authentication (defaults to signIn response; change to register if running register only)
@accessToken = {{signIn.response.body.data.accessToken}}
@userId = {{signIn.response.body.data.userId}}

### Get the authenticated user's record (200)
GET {{baseUrl}}/api/users/{{userId}}
Authorization: Bearer {{accessToken}}

### List users as a candidate (403; admin only)
GET {{baseUrl}}/api/users
Authorization: Bearer {{accessToken}}

### Read another user's record as a candidate (403)
GET {{baseUrl}}/api/users/22222222-2222-4222-8222-222222222222
Authorization: Bearer {{accessToken}}

### Access a protected endpoint without a token (401)
GET {{baseUrl}}/api/users

### Sign in with an incorrect password (401)
POST {{baseUrl}}/api/auth/sign-in
Content-Type: application/json

{
  "email": "{{email}}",
  "password": "incorrect-password"
}

### Register with invalid input (400)
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{
  "name": "Example Candidate",
  "email": "not-an-email",
  "password": "short"
}

### Create the authenticated candidate's profile (201; 409 when it exists)
POST {{baseUrl}}/api/candidates/me
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "fullName": "Example Candidate",
  "headline": "Backend Developer",
  "location": "Amman, Jordan",
  "profileLinks": [
    { "label": "GitHub", "url": "https://github.com/example" }
  ]
}

### Get the candidate profile (200)
GET {{baseUrl}}/api/candidates/me
Authorization: Bearer {{accessToken}}

### Update the candidate profile; null clears an optional field (200)
PATCH {{baseUrl}}/api/candidates/me
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "summary": "Backend developer focused on APIs.",
  "headline": null
}

### Add a manual skill claim (201)
# @name createSkill
POST {{baseUrl}}/api/candidates/me/claims
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "type": "skill",
  "values": { "name": "Python" }
}

###
@claimId = {{createSkill.response.body.data.claimId}}

### Add a manual employment claim (201)
POST {{baseUrl}}/api/candidates/me/claims
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "type": "employment",
  "values": {
    "employer": "Aramex",
    "jobTitle": "Backend Developer",
    "startDate": "2021-03",
    "endDate": "2023-06",
    "location": "Remote",
    "skills": ["Node.js", "PostgreSQL"]
  }
}

### Add a manual education claim (201)
POST {{baseUrl}}/api/candidates/me/claims
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "type": "education",
  "values": {
    "institution": "University of Jordan",
    "degree": "BSc",
    "fieldOfStudy": "Computer Engineering",
    "startDate": "2016-09",
    "endDate": "2020-06"
  }
}

### Add a manual certification claim (201)
POST {{baseUrl}}/api/candidates/me/claims
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "type": "certification",
  "values": {
    "title": "AWS Certified Developer",
    "issuer": "Amazon",
    "issueDate": "2023-01"
  }
}

### List claims, optionally filtered by type and status (200)
GET {{baseUrl}}/api/candidates/me/claims?type=skill
Authorization: Bearer {{accessToken}}

### Edit a claim; previous values are kept as superseded history (200)
PUT {{baseUrl}}/api/candidates/me/claims/{{claimId}}
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "type": "skill",
  "values": { "name": "Python 3" }
}

### Change a claim's type (400)
PUT {{baseUrl}}/api/candidates/me/claims/{{claimId}}
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "type": "certification",
  "values": { "title": "Python", "issuer": "PSF", "issueDate": "2023-01" }
}

### Add a claim with an end date before its start date (400)
POST {{baseUrl}}/api/candidates/me/claims
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "type": "education",
  "values": {
    "institution": "University of Jordan",
    "degree": "BSc",
    "startDate": "2020-09",
    "endDate": "2019-06"
  }
}

### Export the structured profile with accepted claims only (200)
GET {{baseUrl}}/api/candidates/me/profile
Authorization: Bearer {{accessToken}}

### Delete a claim (204; 404 when repeated or owned by another candidate)
DELETE {{baseUrl}}/api/candidates/me/claims/{{claimId}}
Authorization: Bearer {{accessToken}}

### Logout and invalidate all previously issued tokens (204)
POST {{baseUrl}}/api/auth/logout
Authorization: Bearer {{accessToken}}

### Reuse the token after logout (401)
GET {{baseUrl}}/api/users/{{userId}}
Authorization: Bearer {{accessToken}}