@baseUrl = http://localhost:4000
@email = candidate2@example.com
@password = secure-password

### Sign in as an existing candidate (200)
# Register this candidate through api.http first if the account does not exist.
# @name signIn
POST {{baseUrl}}/api/auth/sign-in
Content-Type: application/json

{
  "email": "{{email}}",
  "password": "{{password}}"
}

###
@accessToken = {{signIn.response.body.data.accessToken}}

### Upload the same source twice (201; second result is deduplicated)
# @name uploadDocument
POST {{baseUrl}}/api/candidates/me/documents?purpose=source
Authorization: Bearer {{accessToken}}
Content-Type: multipart/form-data; boundary=LuminaCVBoundary

--LuminaCVBoundary
Content-Disposition: form-data; name="file"; filename="resume-v1.pdf"
Content-Type: application/pdf

< ./documents/valid.pdf
--LuminaCVBoundary
Content-Disposition: form-data; name="file"; filename="resume-v2.pdf"
Content-Type: application/pdf

< ./documents/valid.pdf
--LuminaCVBoundary--

###
@documentId = {{uploadDocument.response.body.data[0].document.documentId}}
# The second result has deduplicated=true and references the same document ID.

### Upload one valid and one disguised invalid PDF (207; mixed results)
# @name mixedUpload
POST {{baseUrl}}/api/candidates/me/documents?purpose=source
Authorization: Bearer {{accessToken}}
Content-Type: multipart/form-data; boundary=LuminaCVMixedBoundary

--LuminaCVMixedBoundary
Content-Disposition: form-data; name="file"; filename="valid-resume.pdf"
Content-Type: application/pdf

< ./documents/valid.pdf
--LuminaCVMixedBoundary
Content-Disposition: form-data; name="file"; filename="disguised-invalid.pdf"
Content-Type: application/pdf

< ./documents/invalid.pdf
--LuminaCVMixedBoundary--

### Exceed the five-file request limit (207; first five results are kept)
# This intentionally sends six files. The response includes
# limit.reached=true and maximumFiles=5.
POST {{baseUrl}}/api/candidates/me/documents?purpose=source
Authorization: Bearer {{accessToken}}
Content-Type: multipart/form-data; boundary=LuminaCVLimitBoundary

--LuminaCVLimitBoundary
Content-Disposition: form-data; name="file"; filename="resume-1.pdf"
Content-Type: application/pdf

< ./documents/valid.pdf
--LuminaCVLimitBoundary
Content-Disposition: form-data; name="file"; filename="resume-2.pdf"
Content-Type: application/pdf

< ./documents/valid.pdf
--LuminaCVLimitBoundary
Content-Disposition: form-data; name="file"; filename="resume-3.pdf"
Content-Type: application/pdf

< ./documents/valid.pdf
--LuminaCVLimitBoundary
Content-Disposition: form-data; name="file"; filename="resume-4.pdf"
Content-Type: application/pdf

< ./documents/valid.pdf
--LuminaCVLimitBoundary
Content-Disposition: form-data; name="file"; filename="resume-5.pdf"
Content-Type: application/pdf

< ./documents/valid.pdf
--LuminaCVLimitBoundary
Content-Disposition: form-data; name="file"; filename="resume-6.pdf"
Content-Type: application/pdf

< ./documents/valid.pdf
--LuminaCVLimitBoundary--

### List source documents (200)
GET {{baseUrl}}/api/candidates/me/documents?purpose=source
Authorization: Bearer {{accessToken}}

### Get the uploaded document metadata (200)
GET {{baseUrl}}/api/candidates/me/documents/{{documentId}}
Authorization: Bearer {{accessToken}}

### Download the original document bytes (200)
# Use the HTTP client's "Save Response Body" action to save and compare the file.
GET {{baseUrl}}/api/candidates/me/documents/{{documentId}}/content
Authorization: Bearer {{accessToken}}

### Upload without purpose (400)
POST {{baseUrl}}/api/candidates/me/documents
Authorization: Bearer {{accessToken}}
Content-Type: multipart/form-data; boundary=LuminaCVBoundary

--LuminaCVBoundary
Content-Disposition: form-data; name="file"; filename="resume.pdf"
Content-Type: application/pdf

< ./documents/valid.pdf
--LuminaCVBoundary--

### Upload with an invalid purpose (400)
POST {{baseUrl}}/api/candidates/me/documents?purpose=avatar
Authorization: Bearer {{accessToken}}
Content-Type: multipart/form-data; boundary=LuminaCVBoundary

--LuminaCVBoundary
Content-Disposition: form-data; name="file"; filename="resume.pdf"
Content-Type: application/pdf

< ./documents/valid.pdf
--LuminaCVBoundary--

### Delete the uploaded document and metadata (204)
DELETE {{baseUrl}}/api/candidates/me/documents/{{documentId}}
Authorization: Bearer {{accessToken}}
