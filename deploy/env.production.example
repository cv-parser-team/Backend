# Copy this file outside the repository, replace every change-me value, and
# upload it to SSM Parameter Store with scripts/aws/put-secrets.sh.
API_DOMAIN=api.example.com
ACME_EMAIL=ops@example.com
# Listed as the server in the OpenAPI document at /docs.
PUBLIC_API_URL=https://api.example.com

POSTGRES_DB=luminacv
POSTGRES_USER=luminacv
POSTGRES_PASSWORD=change-me-use-a-long-url-safe-password
DATABASE_URL=postgresql://luminacv:change-me-use-a-long-url-safe-password@postgres:5432/luminacv

RABBITMQ_DEFAULT_USER=luminacv
RABBITMQ_DEFAULT_PASS=change-me-use-a-long-url-safe-password
RABBITMQ_URL=amqp://luminacv:change-me-use-a-long-url-safe-password@rabbitmq:5672

LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.5-flash-lite
LLM_API_KEY=change-me
LLM_TIMEOUT_MS=30000
LLM_MAX_INPUT_CHARS=100000
NORMALIZATION_AI_ENABLED=true
NORMALIZATION_AI_POLL_INTERVAL_MS=5000
NORMALIZATION_AI_BATCH_SIZE=10

PORT=4000
HOST=0.0.0.0
NODE_ENV=production
JWT_SECRET=change-me-use-at-least-32-random-characters
JWT_ISSUER=luminacv
JWT_AUDIENCE=luminacv-api
DOCUMENT_STORAGE_ROOT=/app/.data/documents
DOCUMENT_MAX_UPLOAD_BYTES=10485760
DOCUMENT_MAX_UPLOAD_FILES=5
DOCUMENT_STAGING_MAX_AGE_SECONDS=86400
DOCUMENT_ORPHAN_GRACE_PERIOD_SECONDS=86400
