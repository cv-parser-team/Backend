{
	email {$ACME_EMAIL}
}

# One domain serves the frontend and the API, so the refresh cookie
# (SameSite=Strict) and API calls stay on the same site.
{$APP_DOMAIN} {
	encode zstd gzip

	@backend path /api /api/* /docs /docs/*
	handle @backend {
		reverse_proxy api:4000
	}

	# Unknown paths fall back to index.html for client-side routes.
	handle {
		root * /srv/frontend
		try_files {path} /index.html
		file_server
	}
}
