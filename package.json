{
  "name": "luminacv",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "LuminaCV - modern talent matching and candidate intelligence backend API",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "parsing:inspect": "tsx src/tools/inspect-parsing.ts",
    "parsing:inspect:all": "tsx src/tools/inspect-all-parsing.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "infra:up": "docker compose up -d postgres rabbitmq",
    "infra:down": "docker compose down",
    "infra:logs": "docker compose logs -f postgres rabbitmq",
    "messaging:up": "docker compose up -d rabbitmq",
    "messaging:down": "docker compose stop rabbitmq",
    "messaging:logs": "docker compose logs -f rabbitmq",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres",
    "db:reset": "docker compose down -v && docker compose up -d postgres",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "@fastify/multipart": "^10.1.6",
    "@fastify/swagger": "^9.9.2",
    "@fastify/swagger-ui": "^6.1.2",
    "amqplib": "^2.2.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "argon2": "^0.45.1",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.2.1",
    "fastify-plugin": "^5.1.0",
    "jose": "^6.2.13",
    "mammoth": "^1.13.0",
    "pdfjs-dist": "^6.4.299",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.10",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "json-schema-to-ts": "^3.1.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^5.0.5"
  }
}