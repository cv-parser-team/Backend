DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/luminacv
RABBITMQ_URL=amqp://luminacv:luminacvpassword@localhost:5672
PORT=4000
HOST=0.0.0.0
NODE_ENV=development
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ISSUER=luminacv
JWT_AUDIENCE=luminacv-api
DOCUMENT_STORAGE_ROOT=.data/documents
DOCUMENT_MAX_UPLOAD_BYTES=10485760
DOCUMENT_MAX_UPLOAD_FILES=5
DOCUMENT_STAGING_MAX_AGE_SECONDS=86400
DOCUMENT_ORPHAN_GRACE_PERIOD_SECONDS=86400
